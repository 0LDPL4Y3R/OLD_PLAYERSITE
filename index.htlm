<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OLD_PLAYER — Официальные источники</title>
    <style>
        /* сброс */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #000000;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', 'Arial', sans-serif;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        /* заголовок с обводкой */
        .main-title {
            font-size: 32px;
            font-weight: 900;
            color: #ff8c00;          /* оранжевый */
            text-shadow: 
                -1px -1px 0 #000,
                 1px -1px 0 #000,
                -1px  1px 0 #000,
                 1px  1px 0 #000,
                 0 0 8px rgba(255, 140, 0, 0.3); /* лёгкое свечение */
            margin-bottom: 50px;
            letter-spacing: 1px;
            word-break: break-word;
        }

        /* блок кнопок */
        .links {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            width: 100%;
            max-width: 400px;
            padding: 18px 24px;
            background-color: #111111;
            border: 2px solid #ff8c00;
            border-radius: 60px;
            text-decoration: none;
            color: #ff8c00;
            font-size: 22px;
            font-weight: 700;
            transition: all 0.25s ease;
            box-shadow: 0 0 12px rgba(255, 140, 0, 0.2);
            text-shadow: 
                -0.5px -0.5px 0 #000,
                 0.5px -0.5px 0 #000,
                -0.5px  0.5px 0 #000,
                 0.5px  0.5px 0 #000;
        }

        .btn:hover {
            background-color: #ff8c00;
            color: #000000;
            box-shadow: 0 0 30px rgba(255, 140, 0, 0.6);
            transform: scale(1.02);
            text-shadow: none;
        }

        /* иконки в кнопках (SVG) */
        .btn svg {
            width: 32px;
            height: 32px;
            fill: currentColor;
            flex-shrink: 0;
        }

        /* адаптив */
        @media (max-width: 500px) {
            .main-title {
                font-size: 24px;
            }
            .btn {
                font-size: 18px;
                padding: 14px 20px;
            }
            .btn svg {
                width: 28px;
                height: 28px;
            }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- ЗАГОЛОВОК -->
    <h1 class="main-title">ОФИЦИАЛЬНЫЕ ИСТОЧНИКИ OLD_PLAYER</h1>

    <!-- КНОПКИ -->
    <div class="links">

        <!-- ТЕЛЕГРАМ -->
        <a href="https://t.me/+HpvQMVtnkDI3YmUy" target="_blank" class="btn">
            <svg viewBox="0 0 24 24">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            Телеграм канал
        </a>

        <!-- ЮТУБ (канал) -->
        <a href="https://www.youtube.com/@OLD_PL4Y3R" target="_blank" class="btn">
            <svg viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            YouTube канал
        </a>

    </div>

</div>

</body>
</html>
